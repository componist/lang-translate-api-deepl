{
    "name": "componist/lang-translate-api-deepl",
    "description": "Artisan command to translate Laravel language PHP files via the DeepL API with dry-run support",
    "keywords": [
        "laravel",
        "deepl",
        "translation",
        "i18n",
        "localization",
        "lang",
        "artisan",
        "componist"
    ],
    "homepage": "https://componist.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Componist Developer",
            "email": "info@componist.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.9"
    },
    "scripts": {
        "phpstan": "phpstan analyse -c phpstan.neon.dist"
    },
    "autoload": {
        "psr-4": {
            "Componist\\LangTranslateApiDeepl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Componist\\LangTranslateApiDeepl\\LangTranslateApiDeeplServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}